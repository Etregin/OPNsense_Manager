<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- Explicitly remove the advertising ID permission: the F-Droid flavor
         excludes the GMA SDK entirely, so this permission must not appear in
         the merged manifest. -->
    <uses-permission
        android:name="com.google.android.gms.permission.AD_ID"
        tools:node="remove"/>

    <application>
        <!--
            Disable the Google Mobile Ads auto-initialisation ContentProvider.
            The GMA AAR registers MobileAdsInitProvider in its own manifest,
            which fires at process start on every flavor.  On F-Droid we must
            prevent any ad-network calls, so we remove it via manifest merger.
        -->
        <provider
            android:name="com.google.android.gms.ads.MobileAdsInitProvider"
            android:authorities="${applicationId}.mobileadsinitprovider"
            tools:node="remove" />
    </application>
</manifest>
