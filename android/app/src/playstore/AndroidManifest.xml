<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Required for Google Mobile Ads SDK: explicitly declare the advertising ID
         permission so Play Console's advertising ID declaration is satisfied.
         Without this, the GMA AAR injects the permission at merge time but Play
         Console still flags the app's own source manifest as non-compliant. -->
    <uses-permission android:name="com.google.android.gms.permission.AD_ID"/>

    <application>
        <!-- Google Mobile Ads App ID (Play Store flavor only) -->
        <!-- Replace placeholder test ID (ca-app-pub-3940256099942544~3347511713) with production AdMob App ID before release -->
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="ca-app-pub-3940256099942544~3347511713"/>
    </application>
</manifest>
